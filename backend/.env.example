# Backend configuration
PORT=8080
ALLOWED_ORIGIN=*
APP_URL=http://0.0.0.0:5173
APP_NAME=GChat
DEFAULT_MODEL=openrouter/auto
BACKEND_URL=http://0.0.0.0:8080

# Backend server binding configuration
# Set BACKEND_HOST to 0.0.0.0 to allow external access to backend API
# Default: localhost (local access only)
# Note: When VITE_HOST=0.0.0.0, BACKEND_HOST will automatically be set to 0.0.0.0 unless explicitly configured
BACKEND_HOST=0.0.0.0

# Frontend development server configuration
# Set VITE_HOST to 0.0.0.0 to allow external access (e.g., from other devices on network)
# Default: localhost (local access only)
VITE_HOST=0.0.0.0
VITE_PORT=5173

# OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Logging configuration
# Set LOGGING=debug to enable detailed debug logging
# Default: no debug logging (only errors and warnings are shown)
LOGGING=debug